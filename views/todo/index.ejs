<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TODO</title>
  <style>
    body { font-family: sans-serif; max-width: 560px; margin: 2rem auto; padding: 0 1rem; }
    form { display: flex; gap: .5rem; }
    input[type="text"] { flex: 1; padding: .5rem; font-size: 1rem; }
    button { padding: .5rem .9rem; font-size: 1rem; cursor: pointer; }
    ul { list-style: none; padding: 0; }
    li { display: flex; align-items: center; gap: .6rem; padding: .5rem 0; border-bottom: 1px solid #ddd; }
    li .title { flex: 1; word-break: break-all; }
    li.done .title { text-decoration: line-through; color: #888; }
    #message { min-height: 1.5rem; color: #c00; }
    #empty { color: #666; }
  </style>
</head>
<body>
  <h1>TODO</h1>
  <form id="todo-form">
    <input type="text" id="title" placeholder="やることを入力（1〜100文字）" autocomplete="off">
    <button type="submit">追加</button>
  </form>
  <p id="message" role="alert"></p>
  <p id="empty" hidden>TODOがありません</p>
  <ul id="todo-list"></ul>
  <script src="/todo/todo.js"></script>
</body>
</html>
